#First soft link this direcoty to the f4_unmapped_reads:
ln -s /mnt/griffin/marvi/Mapping/sorted_bam_files/f4_unmapped_reads /mnt/griffin/marvi/metaSPAdes/

#Need to convert unmapped reads back to R1 & R2 reads in fastQ files, the large dryrun command:
ls f4_unmapped_reads/*f4.bam | xargs -n1 basename -s "_v_ilPieNapi1.2.f4.bam" | parallel --dryrun -j 2 "/data/programs/samtools-1.9/samtools fastq -1 /mnt/griffin/marvi/metaSPAdes/{}_R1.fastq -2 /mnt/griffin/marvi/metaSPAdes/{}_R2.fastq f4_unmapped_reads/{}_v_ilPieNapi1.2.f4.bam"

#The real command:
nohup bash -c 'ls f4_unmapped_reads/*f4.bam | xargs -n1 basename -s "_v_ilPieNapi1.2.f4.bam" | parallel -j 2 "/data/programs/samtools-1.9/samtools fastq -1 /mnt/griffin/marvi/metaSPAdes/{}_R1.fastq -2 /mnt/griffin/marvi/metaSPAdes/{}_R2.fastq f4_unmapped_reads/{}_v_ilPieNapi1.2.f4.bam"' &

#Explanation of the code above:
#-1 — output R1 reads
#-2 — output R2 reads

########################################################################################################################
#After this we can use metaSPAdes:

#Begin by installing SPAdes:
wget https://github.com/ablab/spades/releases/download/v4.3.0/SPAdes-4.3.0-Linux.tar.gz
tar -xzf SPAdes-4.3.0-Linux.tar.gz

#First the large dryrun metaSPAdes command:
ls *_R1.fastq | xargs -n1 basename -s "_R1.fastq" | parallel --dryrun -j 2 "spades.py --meta \
    -1 {}_R1.fastq \
    -2 {}_R2.fastq \
    -t 8 \
    -m 500 \
    -o metaspades_output/{}"

#Now run the real metaSPAdes command:
nohup bash -c 'ls *_R1.fastq | xargs -n1 basename -s "_R1.fastq" | parallel -j 2 "spades.py --meta \
    -1 {}_R1.fastq \
    -2 {}_R2.fastq \
    -t 8 \
    -m 500 \
    -o metaspades_output/{}"' &

#Now we should have the assembled de novo contigs for each sampling location and now we can move forward using Kraken2 to filter out eventual contaminants.