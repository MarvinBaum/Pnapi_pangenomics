#multiQC for visualization of raw files (general read quality), to see general quaility changes.

#Download Multiqc locally:
pip install multiqc

#I then need to export it so it is in my duke directory:
export PATH=$PATH:/home/marvi/.local/bin

#Flagstat gives you all the different aligment you dont need to do all of the f3, etc. in samtools view! Except for the f4 to get the unmapped reads which we will be working with.

#Flagstat command for all sorted bam files:
nohup bash -c 'for bam in *.srt.bam; do
    /data/programs/samtools-1.9/samtools flagstat $bam > ${bam%.bam}.flagstat
done' &

#Do the multiQC on the different sorted bam flagstat files:
multiqc /mnt/griffin/marvi/Mapping/sorted_bam_files -o /mnt/griffin/marvi/MultiQC

#Now we can expand our MultiQC report by using samtools stats:
nohup bash -c '
for bam in *.srt.bam; do
    base=${bam%.srt.bam}

    /data/programs/samtools-1.9/samtools flagstat "$bam" > ${base}.flagstat
    /data/programs/samtools-1.9/samtools stats "$bam" > ${base}.stats
done
' &

#Do the multiQC again on the different sorted bam flagstat and bam stats files:
multiqc /mnt/griffin/marvi/Mapping/sorted_bam_files -o /mnt/griffin/marvi/MultiQC

#Then download multiQC report to local computer:
scp marvi@duke.zoologi.su.se:/mnt/griffin/marvi/MultiQC/multiqc_report_2.html .