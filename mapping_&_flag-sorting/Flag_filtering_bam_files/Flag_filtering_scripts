#####################################################################################################################

#Make a new directory for bam files containing only unmapped reads.
mkdir f4_unmapped

#Dryrun command of large f4 filtering:
ls *.srt.bam | xargs -n1 basename -s "_v_ilPieNapi1.2.srt.bam" | parallel --dryrun -j 2 "/data/programs/samtools-1.9/samtools view -f 4 -b -@ 8 {}_v_ilPieNapi1.2.srt.bam -o f4_unmapped_reads/{}_v_ilPieNapi1.2.f4.bam"

#Same command as before when we sorted the bam file but now we keep only the unmapped reads:
nohup bash -c 'ls *.srt.bam | xargs -n1 basename -s "_v_ilPieNapi1.2.srt.bam" | parallel -j 2 "/data/programs/samtools-1.9/samtools view -f 4 -b -@ 8 {}_v_ilPieNapi1.2.srt.bam -o f4_unmapped_reads/{}_v_ilPieNapi1.2.f4.bam"' &

#Test if filtering works:
/data/programs/samtools-1.9/samtools view -f 4 -b C13stmor_v_ilPieNapi1.2.srt.bam -o f4_unmapped/C13stmor_v_ilPieNapi1.2.f4.bam

