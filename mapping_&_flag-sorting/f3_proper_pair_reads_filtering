#Make a new directory for bam files containing only proper pair reads.
mkdir f3_proper_pair_reads

#Same command as before when we sorted the bam file but now we keep only the proper pair reads:
ls *.srt.bam | xargs -n1 basename -s "_v_ilPieNapi1.2.srt.bam" | parallel "/data/programs/samtools-1.9/samtools view -f 3 -b {}_v_ilPieNapi1.2.srt.bam -o f3_proper_pair_reads/{}_v_ilPieNapi1.2.f3.bam"

#Test if filtering works:
/data/programs/samtools-1.9/samtools view -f 3 -b C13stmor_v_ilPieNapi1.2.srt.bam -o f3_proper_pair_reads/C13stmor_v_ilPieNapi1.2.f3.bam

