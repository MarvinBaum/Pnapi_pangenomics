#Step 1: RepeatMasker
#
#Round 1: Heliconius repeat library (Hmel2) - already completed
#         Results in: /mnt/griffin/marvi/Annotation/repeatmasker_output/
#
#Round 2: Arthropoda library (Dfam v3.0) - IMPROVED approach
#         Following Berner et al. 2023 (Pieris mannii genome paper) who used
#         RepeatMasker with internal Arthropoda repeat library (Dfam v3.0) as first step
#         This is more appropriate than Heliconius library since:
#         - Dfam v3.0 has broader Lepidoptera coverage
#         - Same approach used for sister species P.mannii and P.rapae
#         - Validated in published Pieris genome studies
#
#Note: De novo library construction with RepeatModeler v2.0.1 attempted but failed
#      due to known RECON module bug (exit code 768) in v1.0.8 and dependency
#      conflicts preventing installation of v2.x via conda on duke.
##################################################################################################################################################################################

export PERL5LIB=~/perl5/lib/perl5:$PERL5LIB

#First check -species arthropoda works:
/data/programs/RepeatMasker/RepeatMasker -species arthropoda 2>&1 | head -5

#Create output directory for round 2:
mkdir -p /mnt/griffin/marvi/Annotation/repeatmasker_output_arthropoda

#Test on C13stmor first:
cd /mnt/griffin/marvi/Annotation

export PERL5LIB=~/perl5/lib/perl5:$PERL5LIB

nohup /data/programs/RepeatMasker/RepeatMasker \
    -species arthropoda \
    -pa 4 \
    -xsmall \
    -dir repeatmasker_output_arthropoda/ \
    contigs_for_annotation_1kb/C13stmor_1kb_contigs.fasta &

