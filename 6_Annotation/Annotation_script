#Nanoscript contents:
#!/usr/bin/env python3

#compile_annotation_table.py
#Compiles per-contig annotation table from all annotation steps

import os
import csv
from Bio import SeqIO

samples = ['C13stmor', 'E12aigua', 'S14skanF', 'S14skanM', 'S15lulea',
           'S15stoEA', 'S15stoLA', 'S15stoMJ', 'S15sunds', 'S15umea']

base_dir = '/mnt/griffin/marvi/Annotation'

for sample in samples:
    print(f"Processing {sample}...")

    #Output file:
    outfile = f"{base_dir}/annotation_table/{sample}_annotation_table.tsv"

    #Load contig lengths and GC from masked FASTA:
    contigs = {}
    fasta = f"{base_dir}/repeatmasker_output_arthropoda/{sample}_1kb_contigs.fasta.masked"
    for rec in SeqIO.parse(fasta, 'fasta'):
        seq = str(rec.seq).upper()
        length = len(seq)
        gc = (seq.count('G') + seq.count('C')) / length * 100
        contigs[rec.id] = {'length': length, 'gc': round(gc, 2),
                           'pnapi_hit': 'no', 'pnapi_gene': '',
                           'sprot_hit': 'no', 'sprot_gene': '',
                           'eggnog_GO': '', 'eggnog_KEGG': '',
                           'eggnog_COG': '', 'eggnog_Pfam': '',
                           'augustus_genes': 0}

    #Load DIAMOND Tier 1 hits (P.napi 2022):
    diamond_pnapi = f"{base_dir}/diamond_annotation/2022_diamond_results/{sample}_diamond_pnapi_2022.out"
    if os.path.exists(diamond_pnapi):
        with open(diamond_pnapi) as f:
            for line in f:
                parts = line.strip().split('\t')
                if parts[0] in contigs:
                    contigs[parts[0]]['pnapi_hit'] = 'yes'
                    contigs[parts[0]]['pnapi_gene'] = parts[1]

    #Load DIAMOND Tier 2 hits (SwissProt):
    diamond_sprot = f"{base_dir}/diamond_annotation/diamond_results_sprot_DAS2015/{sample}_diamond_sprot.out"
    if os.path.exists(diamond_sprot):
        with open(diamond_sprot) as f:
            for line in f:
                parts = line.strip().split('\t')
                if parts[0] in contigs:
                    contigs[parts[0]]['sprot_hit'] = 'yes'
                    contigs[parts[0]]['sprot_gene'] = parts[1]

    #Load eggNOG annotations:
    eggnog_file = f"{base_dir}/eggnog_output/{sample}_eggnog.emapper.annotations"
    if os.path.exists(eggnog_file):
        with open(eggnog_file) as f:
            for line in f:
                if line.startswith('#'):
                    continue
                parts = line.strip().split('\t')
                if len(parts) >= 10 and parts[0] in contigs:
                    contigs[parts[0]]['eggnog_GO'] = parts[9] if len(parts) > 9 else ''
                    contigs[parts[0]]['eggnog_KEGG'] = parts[11] if len(parts) > 11 else ''
                    contigs[parts[0]]['eggnog_COG'] = parts[6] if len(parts) > 6 else ''
                    contigs[parts[0]]['eggnog_Pfam'] = parts[20] if len(parts) > 20 else ''

    #Load Augustus gene predictions:
    augustus_file = f"{base_dir}/augustus_output/{sample}_genes.gff3"
    if os.path.exists(augustus_file):
        with open(augustus_file) as f:
            for line in f:
                if line.startswith('#'):
                    continue
                parts = line.strip().split('\t')
                if len(parts) >= 3 and parts[2] == 'gene':
                    contig_id = parts[0]
                    if contig_id in contigs:
                        contigs[contig_id]['augustus_genes'] += 1

    #Write output table:
    with open(outfile, 'w', newline='') as f:
        writer = csv.writer(f, delimiter='\t')
        writer.writerow(['contig_id', 'sample', 'length', 'gc',
                        'pnapi_hit', 'pnapi_gene',
                        'sprot_hit', 'sprot_gene',
                        'eggnog_GO', 'eggnog_KEGG', 'eggnog_COG', 'eggnog_Pfam',
                        'augustus_genes'])
        for contig_id, data in contigs.items():
            writer.writerow([contig_id, sample,
                           data['length'], data['gc'],
                           data['pnapi_hit'], data['pnapi_gene'],
                           data['sprot_hit'], data['sprot_gene'],
                           data['eggnog_GO'], data['eggnog_KEGG'],
                           data['eggnog_COG'], data['eggnog_Pfam'],
                           data['augustus_genes']])

    print(f"{sample}: {len(contigs)} contigs written to {outfile}")

print("All annotation tables complete.")

