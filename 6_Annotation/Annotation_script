#Step 1b: Build de novo P.napi library using RepeatModeler:
mkdir -p /mnt/griffin/marvi/Annotation/repeatmodeler_output
cd /mnt/griffin/marvi/Annotation/repeatmodeler_output

#Build RepeatModeler database from P.napi reference genome:
/data/programs/RepeatModeler/BuildDatabase \
    -name pieris_napi \
    -engine ncbi \
    /data/DB/annotation/DAS/Pnap/Pieris_napi.allpaths.scaffolds.fa

#Run RepeatModeler to build de novo repeat library:
#NOTE: This will take several days - run with nohup
nohup /data/programs/RepeatModeler/RepeatModeler \
    -database pieris_napi \
    -pa 8 &

###################################################################################################################################################################################
#Step 1c: Rerun RepeatMasker with combined Heliconius + de novo P.napi library
#Combine both libraries first:
cat /data/DB/annotation/reference_genomes/Hmel/Hmel2/repeats/Hmel.all.named.final.1-31.lib \
    /mnt/griffin/marvi/Annotation/repeatmodeler_output/pieris_napi-families.fa \
    > /mnt/griffin/marvi/Annotation/combined_repeat_library.fa

#Rerun RepeatMasker with combined library on all samples:
