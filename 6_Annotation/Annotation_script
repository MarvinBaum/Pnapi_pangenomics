#Step 2: DIAMOND blastx annotation
#Two-step approach:
#   2a: Search against P.napi reference proteins (species-specific, 26,473 proteins)
#       - Identifies accessory contigs homologous to known P.napi genes
#   2b: Search against UniProt SwissProt (broader taxonomic context)
#       - For contigs with no P.napi hit - identifies novel sequences with homologs elsewhere
#       - SwissProt results already available from BlobToolKit step
#
#Input: repeat-masked contigs from Step 1 (*.masked files)
#Database 1: P.napi reference proteins found on duke:
#            /data/DB/annotation/DAS/Pnap/genome_annotation_v1/fasta/pienap_proteins.fa
#Database 2: UniProt SwissProt (already built during BlobToolKit step):
#            /mnt/griffin/marvi/BlobToolKit/diamond_db/uniprot_sprot.dmnd
##################################################################################################################################################################################

mkdir -p /mnt/griffin/marvi/Annotation/diamond_annotation
mkdir -p /mnt/griffin/marvi/Annotation/diamond_annotation/diamond_results_pnapi
mkdir -p /mnt/griffin/marvi/Annotation/diamond_annotation/diamond_results_sprot

#Build DIAMOND database from P.napi proteins (one-time, quick):
/data/programs/diamond_v0.9.10/diamond makedb \
    --in /data/DB/annotation/DAS/Pnap/genome_annotation_v1/fasta/pienap_proteins.fa \
    --db /mnt/griffin/marvi/Annotation/diamond_annotation/pienap_proteins \
    --threads 16

##################################################################################################################################################################################
#Step 2a: DIAMOND blastx vs P.napi reference proteins
##################################################################################################################################################################################

#Dryrun first:
ls /mnt/griffin/marvi/Annotation/repeatmasker_output/*_1kb_contigs.fasta.masked | \
    xargs -n1 basename -s "_1kb_contigs.fasta.masked" | parallel --dryrun -j 2 \
    "/data/programs/diamond_v0.9.10/diamond blastx \
    --query /mnt/griffin/marvi/Annotation/repeatmasker_output/{}_1kb_contigs.fasta.masked \
    --db /mnt/griffin/marvi/Annotation/diamond_annotation/pienap_proteins.dmnd \
    --outfmt 6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore \
    --sensitive \
    --max-target-seqs 1 \
    --evalue 1e-5 \
    --threads 8 \
    --out /mnt/griffin/marvi/Annotation/diamond_annotation/diamond_results_pnapi/{}_diamond_pnapi.out"

#Real command:
nohup bash -c 'ls /mnt/griffin/marvi/Annotation/repeatmasker_output/*_1kb_contigs.fasta.masked | \
    xargs -n1 basename -s "_1kb_contigs.fasta.masked" | parallel -j 2 \
    "/data/programs/diamond_v0.9.10/diamond blastx \
    --query /mnt/griffin/marvi/Annotation/repeatmasker_output/{}_1kb_contigs.fasta.masked \
    --db /mnt/griffin/marvi/Annotation/diamond_annotation/pienap_proteins.dmnd \
    --outfmt 6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore \
    --sensitive \
    --max-target-seqs 1 \
    --evalue 1e-5 \
    --threads 8 \
    --out /mnt/griffin/marvi/Annotation/diamond_annotation/diamond_results_pnapi/{}_diamond_pnapi.out"' &

