#Step 1: RepeatMasker.
#This tools hides transposable elements from our data, allowing us to focus on the genes.

#We will use a Heliconius repeat library to extract the repeats from our data (found one on duke).
#Library: Heliconius melpomene repeat library (Hmel2) - closest available Lepidoptera library on duke.
#This is appropriate since repeat element superfamilies (LINEs, SINEs, DNA transposons, Helitrons) are broadly conserved across Lepidoptera.

#Create output direcotory:
mkdir -p /mnt/griffin/marvi/Annotation/repeatmasker_output

#Then test the command:

export PERL5LIB=~/perl5/lib/perl5:$PERL5LIB

nohup /data/programs/RepeatMasker/RepeatMasker \
    -lib /data/DB/annotation/reference_genomes/Hmel/Hmel2/repeats/Hmel.all.named.final.1-31.lib \
    -pa 16 \
    -xsmall \
    -dir /mnt/griffin/marvi/Annotation/repeatmasker_output/ \
    /mnt/griffin/marvi/Annotation/contigs_for_annotation_1kb/C13stmor_1kb_contigs.fasta &

#Do this for the other samples now:

cd /mnt/griffin/marvi/Annotation

export PERL5LIB=~/perl5/lib/perl5:$PERL5LIB

nohup bash -c '
export PERL5LIB=~/perl5/lib/perl5:$PERL5LIB

for sample in E12aigua S14skanM S15lulea S15stoEA S15stoLA S15stoMJ S15sunds S15umea; do
    echo "Running RepeatMasker for ${sample}..."
    /data/programs/RepeatMasker/RepeatMasker \
        -lib /data/DB/annotation/reference_genomes/Hmel/Hmel2/repeats/Hmel.all.named.final.1-31.lib \
        -pa 16 \
        -xsmall \
        -dir /mnt/griffin/marvi/Annotation/repeatmasker_output/ \
        /mnt/griffin/marvi/Annotation/contigs_for_annotation_1kb/${sample}_1kb_contigs.fasta
    echo "${sample}: done"
done
echo "All RepeatMasker jobs complete."
' &

