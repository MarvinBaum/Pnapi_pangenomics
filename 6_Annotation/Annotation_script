#We filter out contigs over 1kb for analysis:
cd /mnt/griffin/marvi/FINAL_contigs_for_annotation
mkdir -p ../Annotation/contigs_for_annotation_1kb

for sample in C13stmor E12aigua S14skanF S14skanM S15lulea S15stoEA S15stoLA S15stoMJ S15sunds S15umea; do
    echo "Filtering ${sample} to >1kb..."
    
    #Extract contig IDs longer than 1kb using awk:
    awk '/^>/{if(seq && length(seq)>=1000){print header; print seq} header=$0; seq=""} 
         !/^>/{seq=seq$0} 
         END{if(seq && length(seq)>=1000){print header; print seq}}' \
        ${sample}_filtered_contigs.fasta \
        > ../Annotation/contigs_for_annotation_1kb/${sample}_1kb_contigs.fasta
    
    total=$(grep -c ">" ${sample}_filtered_contigs.fasta)
    kept=$(grep -c ">" ../Annotation/contigs_for_annotation_1kb/${sample}_1kb_contigs.fasta)
    echo "${sample}: $total total -> $kept retained (>1kb)"
done

#We will still look at the smaller contigs, but this will reduce the noise for the hopefully larger and more informative contigs.

