#Step 2: Diamond blastx.
#We will use diamond blastx to compare the contigs against the NCBI database.

mkdir -p /mnt/griffin/marvi/Annotation/diamond_annotation
mkdir -p /mnt/griffin/marvi/Annotation/diamond_annotation/diamond_results

#Build DIAMOND database from P.napi proteins (one-time, quick):
/data/programs/diamond_v0.9.10/diamond makedb \
    --in /data/DB/annotation/DAS/Pnap/genome_annotation_v1/fasta/pienap_proteins.fa \
    --db /mnt/griffin/marvi/Annotation/diamond_annotation/pienap_proteins \
    --threads 16

#Dryrun first:
ls /mnt/griffin/marvi/Annotation/repeatmasker_output/*_1kb_contigs.fasta.masked | \
    xargs -n1 basename -s "_1kb_contigs.fasta.masked" | parallel --dryrun -j 2 \
    "/data/programs/diamond_v0.9.10/diamond blastx \
    --query /mnt/griffin/marvi/Annotation/repeatmasker_output/{}_1kb_contigs.fasta.masked \
    --db /mnt/griffin/marvi/Annotation/diamond_annotation/pienap_proteins.dmnd \
    --outfmt 6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore \
    --sensitive \
    --max-target-seqs 1 \
    --evalue 1e-5 \
    --threads 8 \
    --out /mnt/griffin/marvi/Annotation/diamond_annotation/diamond_results/{}_diamond_pnapi.out"

#Real command:
nohup bash -c 'ls /mnt/griffin/marvi/Annotation/repeatmasker_output/*_1kb_contigs.fasta.masked | \
    xargs -n1 basename -s "_1kb_contigs.fasta.masked" | parallel -j 2 \
    "/data/programs/diamond_v0.9.10/diamond blastx \
    --query /mnt/griffin/marvi/Annotation/repeatmasker_output/{}_1kb_contigs.fasta.masked \
    --db /mnt/griffin/marvi/Annotation/diamond_annotation/pienap_proteins.dmnd \
    --outfmt 6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore \
    --sensitive \
    --max-target-seqs 1 \
    --evalue 1e-5 \
    --threads 8 \
    --out /mnt/griffin/marvi/Annotation/diamond_annotation/diamond_results/{}_diamond_pnapi.out"' &

