#Step 2: DIAMOND blastx annotation - two-tier approach
#
#Biological rationale:
#Accessory contigs are by definition absent from the P.napi reference genome at the nucleotide
#level (filtered by minimap2). However, they may still share protein-level homology with
#reference genes (divergent alleles, paralogs, population-specific variants). We search against
#two databases in sequence:

#Tier 1: P.napi reference proteins - current annotation (2022) matching reference genome
#        GCF_905475465.1_ilPieNapi1.2 used throughout this pipeline
#        23,367 proteins downloaded from NCBI FTP April 2022
#        GO annotations updated November 2023
#        Downloaded: /mnt/griffin/marvi/Annotation/GCF_905475465.1_ilPieNapi1.2_protein.faa
#        Previously used 2015 DAS annotation (pienap_proteins.fa, 26,473 proteins) - replaced
#        by this current annotation matching the actual reference genome used in this study

#Tier 2: UniProt SwissProt (broader taxonomic context)
#        For contigs with no P.napi hit - identifies novel sequences with homologs elsewhere
#        Subdivides novel contigs: conserved insect genes, contamination, HGT, genuinely novel
#        Database: /mnt/griffin/marvi/BlobToolKit/diamond_db/uniprot_sprot.dmnd (April 2017)
#        Note: 2017

#Input: repeat-masked contigs from Step 1 (*.masked files, Heliconius library)
#evalue 1e-5: relaxed threshold appropriate for intraspecific/paralog comparisons
#             (less strict than 1e-25 used for contamination screening in BlobToolKit)
##################################################################################################################################################################################

cd /mnt/griffin/marvi/Annotation

mkdir -p diamond_annotation/diamond_results_pnapi_v2
mkdir -p diamond_annotation/diamond_results_sprot

#Build DIAMOND database from current P.napi reference proteins:
/data/programs/diamond_v0.9.10/diamond makedb \
    --in GCF_905475465.1_ilPieNapi1.2_protein.faa \
    --db diamond_annotation/pienap_ilPieNapi1.2_proteins \
    --threads 16

