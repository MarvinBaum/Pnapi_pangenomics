ls repeatmasker_output_arthropoda/skane_gcfiltered/*_gcfiltered.fasta.masked | \
    xargs -n1 basename -s "_1kb_contigs_gcfiltered.fasta.masked" | parallel --dryrun -j 2 \
    "/data/programs/diamond_v0.9.10/diamond blastx \
    --query repeatmasker_output_arthropoda/skane_gcfiltered/{}_1kb_contigs_gcfiltered.fasta.masked \
    --db diamond_annotation/pienap_ilPieNapi1.2_proteins.dmnd \
    --outfmt 6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore \
    --sensitive \
    --max-target-seqs 1 \
    --evalue 1e-5 \
    --threads 8 \
    --out diamond_annotation/2022_diamond_results/skane_gcfiltered/{}_diamond_pnapi_2022_gcfiltered.out"

