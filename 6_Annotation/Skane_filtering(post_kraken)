#Skåne GC-filtered reanalysis

#S14skanF and S14skanM showed severe bacterial contamination despite Kraken2 filtering:
#   - GC content: 60.65% (S14skanF) and 59.36% (S14skanM) vs ~33-40% expected for Lepidoptera
#   - RepeatMasker: only 1.0-1.16% masking (bacterial sequences lack eukaryotic TEs)
#   - DIAMOND: 57.9% and 54.9% SwissProt hits (mostly bacterial proteins)
#   - BlobToolKit: clear bacterial cluster at 0.55-0.70 GC in combined blobplots

#Solution: BlobToolKit GC filter (gc--Max=0.50) removes bacterial contigs
#Results: S14skanF 9,571 → 3,877 contigs (59.5% removed)
#         S14skanM 6,915 → 2,958 contigs (57.2% removed)

#Filtered FASTAs located at:
#   /mnt/griffin/marvi/Annotation/skane_gcfiltered/S14skanF_1kb_contigs_gcfiltered.fasta
#   /mnt/griffin/marvi/Annotation/skane_gcfiltered/S14skanM_1kb_contigs_gcfiltered.fasta
##################################################################################################################################################################################

##################################################################################################################################################################################
#Step 1: RepeatMasker (Arthropoda Dfam) on GC-filtered contigs
##################################################################################################################################################################################

cd /mnt/griffin/marvi/Annotation
export PERL5LIB=~/perl5/lib/perl5:$PERL5LIB

mkdir -p repeatmasker_output_arthropoda/skane_gcfiltered

nohup bash -c '
export PERL5LIB=~/perl5/lib/perl5:$PERL5LIB

for sample in S14skanF S14skanM; do
    echo "Running RepeatMasker (Arthropoda) for ${sample} GC-filtered..."
    /data/programs/RepeatMasker/RepeatMasker \
        -species arthropoda \
        -pa 4 \
        -xsmall \
        -dir /mnt/griffin/marvi/Annotation/repeatmasker_output_arthropoda/skane_gcfiltered/ \
        /mnt/griffin/marvi/Annotation/skane_gcfiltered/${sample}_1kb_contigs_gcfiltered.fasta
    echo "${sample}: done"
done
echo "RepeatMasker complete for GC-filtered Skane samples."
' &

