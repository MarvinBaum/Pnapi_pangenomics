##########################################################################################################################
#Kraken2 contamination filtering - remove contaminated contigs before annotation
###########################################################################################################################

#Strategy: filter the accessory contigs (post-minimap2) to remove contamination
#before annotation of the accessory pangenome.

#Contaminants identified from Kraken2 reports:
#   - Human (taxid 9606) - present in all samples (~1-1.4%)
#   - Bacteria (taxid 2) - root node covering ALL bacterial contamination:
#       Delftia spp. (S14skanF, S14skanM)
#       Rahnella spp. (S15stoEA, S15stoMJ)
#       Phyllobacterium spp. (S15lulea, S15sunds, S15umea)
#       Serratia spp. (S15stoEA, S15stoMJ)
#       Wolbachia spp. (all samples, especially S15lulea 0.45%)
#       Enterobacteriaceae (most samples)

#Input: accessory_contigs_filtered/{sample}_accessory_contigs.fasta (post-minimap2)
#Output: contigs_after_minimap_and_kraken/{sample}_filtered_contigs.fasta (ready for annotation)

cd /mnt/griffin/marvi/Kraken2

#Dryrun - check how many contaminant contigs would be removed per sample:
for sample in C13stmor E12aigua S14skanF S14skanM S15lulea S15stoEA S15stoLA S15stoMJ S15sunds S15umea; do
    echo "=== ${sample} ==="

    #Count total accessory contigs:
    total=$(grep -c ">" accessory_contigs_filtered/${sample}_accessory_contigs.fasta)

    #Count contaminant contigs (classified as human or bacteria):
    contaminants=$(grep "^C" kraken2_output/${sample}.kraken | \
        awk '($3==9606) || ($3==2) || ($3==1224) || ($3==28216) || ($3==28211) || \
             ($3==1236) || ($3==91347) || ($3==80840) || ($3==356) || ($3==953)' | \
        wc -l)

    clean=$((total - contaminants))
    echo "Total: $total | Contaminants: $contaminants | Clean: $clean"
done

