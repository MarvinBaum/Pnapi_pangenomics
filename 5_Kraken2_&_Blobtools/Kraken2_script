########################################################################################################################
#Begin by soft linking the accesory contigs generated from the minimap2 part of analysis:
ln -s /mnt/griffin/marvi/minimap2/accessory_contigs_filtered /mnt/griffin/marvi/Kraken2/

#Then install Kraken2
cd /mnt/griffin/marvi/Kraken2
wget https://github.com/DerrickWood/kraken2/archive/refs/tags/v2.17.1.tar.gz
tar -xzf v2.17.1.tar.gz
cd kraken2-2.17.1
./install_kraken2.sh /mnt/griffin/marvi/Kraken2

#Download standard database via web (couldn't use rsync och FTP as network rejected it):
nohup bash -c 'cd /mnt/griffin/marvi/Kraken2 && wget https://genome-idx.s3.amazonaws.com/kraken/k2_standard_20260226.tar.gz && mkdir -p db && tar -xzf k2_standard_20260226.tar.gz -C db' &

##########################################################################################################################
#Now to run Kraken2 on the contigs:

#Make a directory for the output:
mkdir -p kraken2_output

#Now for the Kraken2 dryun command:
ls accessory_contigs_filtered/*_accessory_contigs.fasta | xargs -n1 basename -s "_accessory_contigs.fasta" | parallel --dryrun -j 2 \
    "/mnt/griffin/marvi/Kraken2/kraken2 \
    --db /mnt/griffin/marvi/Kraken2/db \
    --threads 8 \
    --output kraken2_output/{}.kraken \
    --report kraken2_output/{}.report \
    accessory_contigs_filtered/{}_accessory_contigs.fasta"

#And now the real Kraken2 command:
nohup bash -c 'ls accessory_contigs_filtered/*_accessory_contigs.fasta | xargs -n1 basename -s "_accessory_contigs.fasta" | parallel -j 2 \
    "/mnt/griffin/marvi/Kraken2/kraken2 \
    --db /mnt/griffin/marvi/Kraken2/db \
    --threads 8 \
    --output kraken2_output/{}.kraken \
    --report kraken2_output/{}.report \
    accessory_contigs_filtered/{}_accessory_contigs.fasta"' &

###########################################################################################################################
#We can use the program Krona to visualize the Kraken2 output, begin by installing:
cd /mnt/griffin/marvi/Kraken2
wget https://github.com/marbl/Krona/releases/download/v2.8.1/KronaTools-2.8.1.tar
tar -xvf KronaTools-2.8.1.tar
cd KronaTools-2.8.1
./install.pl --prefix=/mnt/griffin/marvi/Kraken2/KronaTools-2.8.1

#Build the local taxonomy database:
./updateTaxonomy.sh

#Then generate Krona charts from the Kraken2 outputs:
cd /mnt/griffin/marvi/Kraken2/kraken2_output

mkdir -p krona_output

for report in *.report; do
    sample=$(basename "$report" .report)
    /mnt/griffin/marvi/Kraken2/KronaTools-2.8.1/bin/ktImportTaxonomy \
        -t 5 -m 3 \
        -o krona_output/${sample}_krona.html \
        "$report"
done

#This will now give us Krona charts for easier visualization, move this to my local computer to uppload to github:
scp -r marvi@duke.zoologi.su.se:/mnt/griffin/marvi/Kraken2/kraken2_output/krona_output/* .

#Now we can move on to using Blobtools.

#Bonus, useful command to view downloadning status:
tail -5 nohup.out

