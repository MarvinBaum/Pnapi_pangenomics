#Begin by soft linking the accesory contigs generated from the minimap2 part of analysis:
ln -s /mnt/griffin/marvi/minimap2/accessory_contigs_filtered /mnt/griffin/marvi/Kraken2/

#Then install Kraken2
cd /mnt/griffin/marvi/Kraken2
