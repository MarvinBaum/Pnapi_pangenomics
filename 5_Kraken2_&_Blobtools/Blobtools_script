#Then the command to get taxonomy correct:

nano taxify_diamond_results.sh

#All the following is in a nanoscript:

#!/bin/bash

cd /mnt/griffin/marvi/BlobToolKit/diamond_db

for sample in C13stmor E12aigua S14skanF S14skanM S15lulea S15stoEA S15stoLA S15stoMJ S15sunds S15umea; do
    echo "Taxifying $sample..."

    awk -F'\t' '{split($2,p,"|"); print p[2]"\t"$0}' diamond_results/${sample}_diamond.out | sort -k1,1 > /tmp/${sample}_with_acc.txt

    join -t $'\t' -1 1 -2 1 /tmp/${sample}_with_acc.txt taxid_map_sorted.txt | \
        awk -F'\t' '{print $2"\t"$NF"\t"$13"\t"$2"\t"$3"\t"$4"\t"$5"\t"$6"\t"$7"\t"$8"\t"$9"\t"$10"\t"$11"\t"$12"\t"$13}' \
        > taxified_results/${sample}_diamond_taxified.out

    rm /tmp/${sample}_with_acc.txt

    echo "$sample: $(wc -l < diamond_results/${sample}_diamond.out) hits -> $(wc -l < taxified_results/${sample}_diamond_taxified.out) taxified"

done

#Run the script:
nohup bash taxify_diamond_results.sh &

