#Step 3:Build Diamond database:

#Build a DIAMOND database from the existing UniProt SwissProt fasta:

mkdir -p /mnt/griffin/marvi/BlobToolKit/diamond_db
cd /mnt/griffin/marvi/BlobToolKit/diamond_db

#First, get the taxdump if not already done:
mkdir -p ../taxdump
cd ../taxdump
wget https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/new_taxdump/new_taxdump.tar.gz
tar -xzf new_taxdump.tar.gz
cd ../diamond_db

#3b. Download the UniProt accession-to-taxid mapping file.
#Checked first: confirmed 6.6GB compressed, ~11 min at duke's connection speed - quick enough to just run directly.
mkdir -p /mnt/griffin/marvi/BlobToolKit/diamond_db
cd /mnt/griffin/marvi/BlobToolKit/diamond_db

nohup bash -c 'wget -c https://ftp.uniprot.org/pub/databases/uniprot/current_release/knowledgebase/idmapping/idmapping_selected.tab.gz && \
    gunzip idmapping_selected.tab.gz && \
    cut -f 1,13 idmapping_selected.tab > taxid_map.txt' &

#3c. Once the taxid_map.txt has finished downloading, build the DIAMOND database WITH taxonomy mapping:
/data/programs/diamond_v0.9.10/diamond makedb \
    --in /data/DB/blast/uniprot/uniprot_sprot.fasta \
    --taxonmap taxid_map.txt \
    --taxonnodes ../taxdump/nodes.dmp \
    --threads 16 \
    -d uniprot_sprot

#######################################################################################################################
#Step 4: Run DIAMOND BLASTX against UniProt SwissProt for each sample's contigs

mkdir -p /mnt/griffin/marvi/BlobToolKit/diamond_db/diamond_results

#Dryrun first:
ls contigs_renamed/*_contigs.fasta | xargs -n1 basename -s "_contigs.fasta" | parallel --dryrun -j 2 \
    "/data/programs/diamond_v0.9.10/diamond blastx \
    --query contigs_renamed/{}_contigs.fasta \
    --db diamond_db/uniprot_sprot.dmnd \
    --outfmt 6 qseqid staxids bitscore qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore \
    --sensitive \
    --max-target-seqs 1 \
    --evalue 1e-25 \
    --threads 8 \
    --out diamond_db/diamond_results/{}_diamond.out"

#Now for the real command:
nohup bash -c 'ls contigs_renamed/*_contigs.fasta | xargs -n1 basename -s "_contigs.fasta" | parallel -j 2 \
    "/data/programs/diamond_v0.9.10/diamond blastx \
    --query contigs_renamed/{}_contigs.fasta \
    --db diamond_db/uniprot_sprot.dmnd \
    --outfmt 6 qseqid staxids bitscore qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore \
    --sensitive \
    --max-target-seqs 1 \
    --evalue 1e-25 \
    --threads 8 \
    --out diamond_db/diamond_results/{}_diamond.out"' &
